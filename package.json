{
  "name": "adaxai-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "ADAXAI MVP: role-based clinical web platform, API, PostgreSQL and thermal service.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/db.mjs start && concurrently --kill-others-on-fail --names api,web,thermal,speech,llm --prefix-colors blue,magenta,green,yellow,cyan \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:thermal\" \"npm:dev:speech\" \"npm:dev:llm\"",
    "dev:api": "npm run dev --workspace @adaxai/api",
    "dev:web": "npm run dev --workspace @adaxai/web",
    "dev:thermal": "node scripts/thermal.mjs dev",
    "dev:speech": "node scripts/speech.mjs dev",
    "dev:llm": "node scripts/llm.mjs dev",
    "llm:setup": "node scripts/llm.mjs setup",
    "llm:status": "node scripts/llm.mjs status",
    "llm:verify": "node scripts/llm.mjs verify",
    "eval:consult": "npm run eval:consult --workspace @adaxai/api --",
    "eval:mana": "npm run eval:mana --workspace @adaxai/api --",
    "speech:setup": "node scripts/speech.mjs venv",
    "speech:model": "node scripts/speech.mjs model",
    "db:init": "node scripts/db.mjs init",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:provision": "node scripts/db.mjs provision",
    "db:selftest": "node scripts/db.mjs selftest",
    "db:migrate": "npm run migrate --workspace @adaxai/api --",
    "db:seed": "npm run seed --workspace @adaxai/api",
    "db:generate": "npm run generate --workspace @adaxai/api",
    "retention": "npm run retention --workspace @adaxai/api --",
    "backup": "node scripts/backup.mjs backup",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "demo:seed": "npm run demo:seed --workspace @adaxai/api --",
    "demo:hospital": "npm run demo:hospital --workspace @adaxai/api --",
    "demo:devices": "npm run demo:devices --workspace @adaxai/api --",
    "demo:hero": "npm run demo:hero --workspace @adaxai/api --",
    "devices:simulate": "npm run devices:simulate --workspace @adaxai/api --",
    "user:reset-password": "npm run user:reset-password --workspace @adaxai/api --",
    "audit:verify": "npm run audit:verify --workspace @adaxai/api --",
    "lint": "oxlint --deny-warnings apps packages scripts e2e && node scripts/thermal.mjs lint && node scripts/speech.mjs lint",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.e2e.json",
    "test": "npm run test:api && npm run test:web && npm run test:thermal && npm run test:speech && npm run test:e2e",
    "test:web": "npm run test --workspace @adaxai/web",
    "test:api": "node scripts/db.mjs start && npm run migrate --workspace @adaxai/api -- --target test && npm run test --workspace @adaxai/api",
    "test:thermal": "node scripts/thermal.mjs test",
    "test:speech": "node scripts/speech.mjs test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "embedded-postgres": "17.10.0-beta.17",
    "oxlint": "1.86.0",
    "pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
