# ADAXAI MVP local environment.
#
# `npm run setup` copies this file to `.env` and fills every empty *_PASSWORD
# with a random value. `.env` is git-ignored. Never commit real credentials.

NODE_ENV=development

# --- PostgreSQL (local cluster managed by scripts/db.mjs) -------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=adaxai
DB_TEST_NAME=adaxai_test
# Used only by the Playwright end-to-end suite (reset and re-seeded every run).
DB_E2E_NAME=adaxai_e2e
# Cluster superuser: used only by db scripts and migrations.
DB_ADMIN_USER=adaxai_admin
DB_ADMIN_PASSWORD=
# Application role: data access only (no DDL, no superuser).
DB_APP_USER=adaxai_app
DB_APP_PASSWORD=
# Location of the cluster's data directory (git-ignored).
DB_DATA_DIR=.data/pg

# --- Services ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=5173
THERMAL_HOST=127.0.0.1
THERMAL_PORT=8001
THERMAL_URL=http://127.0.0.1:8001
# Optional: path to the Python 3.11+ interpreter used to create the thermal
# service's virtual environment (default: py/python3/python on PATH).
PYTHON=
# Recorded on thermal images, clinical images and AI jobs. Keep `synthetic` for
# development and demos; set `clinical` only in a real clinical deployment.
# Non-clinical data is labelled as such in exports, metrics and reports.
DATA_ORIGIN=synthetic

# --- Sessions ------------------------------------------------------------------
# Secure cookies need HTTPS. Leave unset for local HTTP (defaults to true when
# NODE_ENV=production).
COOKIE_SECURE=

# --- Synthetic demo accounts -----------------------------------------------------
# Password for the seeded demo users (admin, dr.meera, dr.rahul, nurse.anil).
# Generated by `npm run setup`; local development only.
SEED_DEMO_PASSWORD=

# --- Files ---------------------------------------------------------------------
# Uploaded files (git-ignored).
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# --- AI consultation assistant (optional) ------------------------------------------
# Leave empty to run without AI: the app then says drafting/transcription is
# unavailable and never shows placeholder output. Transcripts are sent to these
# providers only after the patient's consent, with registered identifiers
# replaced by placeholders. Check your data-processing agreement first.
# Note drafting with Claude (Anthropic API):
ANTHROPIC_API_KEY=
# Hosted AI egress. A key above does NOT allow anything to be sent: consultation text goes to the hosted provider only if egress is allowed on
# purpose, here (true) or in config/adaxai.yaml (ai.egress.hostedProviders). Empty: the file decides (false). Audio never leaves this computer.
AI_EGRESS_HOSTED=

# Optional overrides of config/adaxai.yaml (leave empty to use the YAML values).
AI_NOTE_MODEL=
# Speech-to-text runs ON THIS MACHINE ONLY (the local speech service in services/speech, faster-whisper).
# There is no hosted speech-to-text: audio never leaves the machine, and nothing falls back to a hosted service.
# `none` (the default) until you set up the runtime on purpose:
#   npm run speech:setup   (Python packages)   npm run speech:model   (the model, about 486 MB, asks first)
# then set SPEECH_PROVIDER=local and restart. SPEECH_URL must point at this machine (127.0.0.1).
SPEECH_PROVIDER=none
SPEECH_URL=http://127.0.0.1:8002
SPEECH_HOST=127.0.0.1
SPEECH_PORT=8002
# Where the model lives (default .data/models/faster-whisper-small).
SPEECH_MODEL_DIR=
# An old AI_STT_API_KEY is ignored (the server says so at start-up); remove it from your .env.

# --- Device readings (V5) ------------------------------------------------------------
# Optional overrides of config/adaxai.yaml (devices.liveSeconds, devices.disconnectedSeconds): how long a device reading counts as live, and
# how long a gateway may be silent before its device is shown as disconnected. Empty: the settings file decides (30 and 120 seconds).
DEVICE_LIVE_SECONDS=
DEVICE_DISCONNECTED_SECONDS=

# --- Local AI consultation intelligence (V3) ---------------------------------------
# A language model that runs ON THIS MACHINE (llama.cpp's llama-server, scripts/llm.mjs). The patient's record goes to a loopback address only.
#   npm run llm:setup   (downloads the pinned runtime, about 19 MB, and model, about 2.74 GB; asks first; every file is hash-checked)
#   npm run dev:llm     (starts it; `npm run dev` starts it too when it is installed)
# `local` (the default in config/adaxai.yaml), `none` (switched off) or `hosted` (only behind AI_EGRESS_HOSTED and a key; never used because the
# local model is down). Empty: the settings file decides. If the local model is not running the screens say "Local AI unavailable."
LLM_PROVIDER=
LLM_URL=
# The per-install secret the model server checks (scripts/llm.mjs creates .data/llm/api-key and the API reads it from there). Set this only if you
# run the server yourself; it is never sent to a browser or logged.
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_PORT=8081
LLM_CTX=8192
LLM_THREADS=
