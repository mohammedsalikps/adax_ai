{
  "name": "@adaxai/api",
  "private": true,
  "version": "0.1.0",
  "description": "ADAXAI API: Fastify + PostgreSQL (Drizzle).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed.ts",
    "retention": "tsx src/retention-cli.ts",
    "demo:seed": "tsx src/db/demo-seed.ts",
    "demo:hospital": "tsx src/db/hospital-seed.ts",
    "demo:devices": "tsx src/devices/demo-devices.ts",
    "devices:simulate": "tsx src/devices/simulate-cli.ts",
    "user:reset-password": "tsx src/reset-password-cli.ts",
    "audit:verify": "tsx src/audit/verify-cli.ts",
    "eval:consult": "tsx src/eval/consult-cli.ts",
    "eval:mana": "tsx src/eval/mana-cli.ts",
    "generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@adaxai/contracts": "*",
    "@anthropic-ai/sdk": "0.131.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
